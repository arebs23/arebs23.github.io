{% assign linked_project = site.projects | where: 'url', entry.project_path | first %}
<article class="publication-entry{% if linked_project.demo_url %} publication-entry-with-demo{% endif %}" data-publication-year="{{ entry.year }}">
  <div class="publication-details">
    <h2>{{ entry.title | escape }}</h2>
    <p class="publication-authors">
      {% for author in entry.author_array %}
        {%- if author.first == 'Victor' and author.last == 'Aregbede' -%}
          <strong>{{ author.first }} {{ author.last }}</strong>
        {%- else -%}
          {{ author.first }} {{ author.last }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {% endfor %}
    </p>
    <p class="portfolio-meta">{{ entry.year }} · {{ entry.topic | escape }} · {{ entry.abbr | escape }}</p>
    <div class="publication-links">
      {% if linked_project %}<a href="{{ linked_project.url | relative_url }}">Project</a>{% endif %}
      {% if entry.website %}<a href="{{ entry.website | escape }}">Website</a>{% endif %}
      {% if entry.html %}
        <a href="{{ entry.html | escape }}">Paper</a>
      {% elsif entry.doi %}
        <a href="https://doi.org/{{ entry.doi | escape }}">Paper</a>
      {% endif %}
      {% if entry.code %}<a href="{{ entry.code | escape }}">Code</a>{% endif %}
      {% if linked_project.demo_url %}<a href="{{ linked_project.demo_url | escape }}">Demo video</a>{% endif %}
    </div>
  </div>
  {% if linked_project.demo_url %}
    {% include portfolio_demo.liquid project=linked_project %}
  {% endif %}
</article>
